PORT=4100
JWT_SECRET=replace-this-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5174

# Optional: absolute path to the SQLite file. Leave unset locally (defaults
# to mod-report-backend/data.sqlite3). In production, point this at a
# persistent disk mount (e.g. Render: /var/data/mod-report.sqlite3) so data
# survives redeploys.
DB_PATH=
