PORT=4000
JWT_SECRET=replace-this-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173

# Optional: absolute path to the SQLite file. Leave unset locally (defaults
# to backend/data.sqlite3). In production, point this at a persistent disk
# mount (e.g. Render: /var/data/data.sqlite3) so data survives redeploys.
DB_PATH=

# Email (used for sending quotes/invoices/reminders as PDF attachments).
# Leave unset locally if you don't need to test sending — quote/invoice/reminder
# emails will fail with a clear "not configured" error, everything else still works.
# Example values for a Gmail account with an app password:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Automated database backups (see backend/src/lib/backup.js). Daily at 03:00
# server time, a consistent SQLite snapshot is gzipped and uploaded to any
# S3-compatible bucket — Cloudflare R2 is the cheapest option (no egress
# fees, generous free tier, effectively $0/mo for a database this size).
# Leave BACKUP_S3_BUCKET unset locally — backups are skipped, not an error.
# Manual commands: `npm run backup`, `npm run backup:list`,
# `npm run backup:restore -- <key> [dest-path]`.
#   R2 example:
#     BACKUP_S3_BUCKET=edusolution-backups
#     BACKUP_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#     BACKUP_S3_REGION=auto
#     BACKUP_S3_ACCESS_KEY_ID=...
#     BACKUP_S3_SECRET_ACCESS_KEY=...
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
