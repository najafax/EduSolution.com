# nginx static hosting for the React frontend (replaces Render's static site)
# on www.edusolutionsmaldives.com (+ the bare domain, redirected to www).
# Files live in /var/www/edusolution-frontend, written by deploy.sh.
# Install as:
#   sudo cp nginx-web.conf.template /etc/nginx/sites-available/edusolution-web
#   sudo ln -s /etc/nginx/sites-available/edusolution-web /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d www.edusolutionsmaldives.com -d edusolutionsmaldives.com
# (run certbot only after DNS for both names points at this droplet)

server {
    listen 80;
    listen [::]:80;
    server_name edusolutionsmaldives.com;
    return 301 https://www.edusolutionsmaldives.com$request_uri;
}

server {
    listen 80;
    listen [::]:80;
    server_name www.edusolutionsmaldives.com;

    root /var/www/edusolution-frontend;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/manifest+json;

    # Hashed build files never change: cache for a year.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # The service worker, its helpers and the HTML shell must never be cached,
    # or installed PWAs would not notice a new deploy.
    location = /sw.js { add_header Cache-Control "no-cache"; try_files $uri =404; }
    location ~ ^/(workbox-.*\.js|registerSW\.js|manifest\.webmanifest)$ { add_header Cache-Control "no-cache"; try_files $uri =404; }
    location = /index.html { add_header Cache-Control "no-cache"; }

    # Single-page app: any other path falls back to index.html.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
