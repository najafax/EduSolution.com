# nginx reverse proxy for api.edusolutionsmaldives.com -> the local Node
# backend (systemd service on 127.0.0.1:4000). Install as:
#   sudo cp nginx-api.conf.template /etc/nginx/sites-available/edusolution-api
#   sudo ln -s /etc/nginx/sites-available/edusolution-api /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d api.edusolutionsmaldives.com
# certbot will rewrite this file in place to add the TLS (443) server block
# and the HTTP->HTTPS redirect — the server_name below just needs to match
# the real domain before you run it.

server {
    listen 80;
    listen [::]:80;
    server_name api.edusolutionsmaldives.com;

    # Payment-proof uploads can run a few MB (see backend's own 8mb JSON
    # body limit in index.js) — nginx's own default (1m) would reject them
    # with a 413 before the request ever reaches Node.
    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # PDF/export downloads can take a few seconds to render — give them
        # more room than nginx's 60s default before calling it a timeout.
        proxy_read_timeout 120s;
    }
}
