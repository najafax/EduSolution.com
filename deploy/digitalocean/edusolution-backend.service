[Unit]
Description=EduSolution.com backend (Node/Express API)
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/edusolution-backend/backend
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5
# Loads PORT/JWT_SECRET/CLIENT_ORIGIN/DB_PATH/SMTP_*/BACKUP_S3_* from .env —
# same file the app already reads via dotenv, no systemd EnvironmentFile
# duplication needed.
EnvironmentFile=/home/deploy/edusolution-backend/backend/.env
# Hardening — this process only needs to read/write its own app dir and the
# persistent data disk; it never needs raw device/network-admin access.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/deploy/edusolution-backend/backend /var/data
# lib/backup.js's createSnapshot() writes its VACUUM INTO temp file to
# os.tmpdir() (/tmp) before gzipping/uploading it — without this, /tmp sits
# outside ReadWritePaths above and ProtectSystem=strict makes it read-only,
# so every cron-triggered backup silently fails with "unable to open
# database" while a manual, non-systemd-managed run (no sandboxing at all)
# keeps working and masks the problem. PrivateTmp=true is the standard
# complement to ProtectSystem=strict — it gives this service its own
# isolated, writable /tmp namespace rather than widening ReadWritePaths to
# the real, shared /tmp.
PrivateTmp=true

[Install]
WantedBy=multi-user.target
