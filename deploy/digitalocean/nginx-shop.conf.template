# nginx for the retail shop: shop.edusolutionsmv.com.
# It serves the SAME built frontend as the main site (the app picks the
# storefront when the hostname starts with "shop.") and talks to the same API.
# Install as:
#   sudo cp nginx-shop.conf.template /etc/nginx/sites-available/edusolution-shop
#   sudo ln -s /etc/nginx/sites-available/edusolution-shop /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d shop.edusolutionsmv.com
# (add the DNS A record for "shop" pointing at this droplet first)

server {
    listen 80;
    listen [::]:80;
    server_name shop.edusolutionsmv.com;

    root /var/www/edusolution-frontend;
    index index.html;

    # Link previews (WhatsApp, Facebook, Viber...) don't run the app, so
    # they would show the main site's title. Give the shop its own.
    sub_filter_once on;
    sub_filter '<title>Edu Solutions</title>' '<title>Edu Solutions Shop</title><meta property="og:type" content="website"><meta property="og:site_name" content="Edu Solutions Shop"><meta property="og:title" content="Edu Solutions Shop"><meta property="og:description" content="Air conditioners, TVs, fridges and more, delivered to the island or boat you choose."><meta property="og:url" content="https://shop.edusolutionsmv.com/"><meta property="og:image" content="https://shop.edusolutionsmv.com/shop-share.png"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta name="twitter:card" content="summary_large_image">';
    sub_filter '<meta name="description" content="Edu Solutions — learning, simplified." />' '<meta name="description" content="Air conditioners, TVs, fridges and more, delivered to the island or boat you choose." />';

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
    location = /sw.js { add_header Cache-Control "no-cache"; try_files $uri =404; }
    location = /index.html { add_header Cache-Control "no-cache"; }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
